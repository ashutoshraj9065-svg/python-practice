   "source": [
    "def ashu(arr):\n",
    "    n=len(arr)\n",
    "    for i in range(1,n):\n",
    "        k=arr[i] \n",
    "        j=i-1\n",
    "        while j>=0 and k<arr[j]:\n",
    "            arr[j+1]=arr[j]\n",
    "            j=j-1\n",
    "        arr[j+1]=k\n",
    "    return arr"
   ]
  },
