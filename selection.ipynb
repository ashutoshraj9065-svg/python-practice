   "source": [
    "def ashu(arr):\n",
    "      n=len(arr)\n",
    "      for i in range(n-1):\n",
    "          min=i\n",
    "          for j in range(i+1,n):\n",
    "              if arr[j]<arr[min]:\n",
    "                  min=j\n",
    "          arr[i],arr[min]=arr[min],arr[i]\n",
    "      return arr"
   ]
  },
