   "source": [
    "def even_indices(nums):\n",
    "    result = []\n",
    "\n",
    "    for i in range(len(nums)):\n",
    "        if nums[i] % 2 == 0:\n",
    "            result.append(i)\n",
    "\n",
    "    return result"
   ]
  },
